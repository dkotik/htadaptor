<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <title>Contact</title>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6" integrity="sha384-6lyVbhrs13b9z7mLOpt/N6R76rtkEBWgCjAXRs/DSWyi2AMnQSs10ijWk+PI8n7W" crossorigin="anonymous"></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    >
  </head>
  <body>
    <style>
      .htmx-indicator {
          opacity: 0;
          visibility: hidden;
          max-height: 1.5rem;
          max-width: 1.5rem;
          margin: 0.4rem 1rem 0 1rem;
      }
      .htmx-request .htmx-indicator,
      .htmx-request.htmx-indicator {
          opacity: 1;
          visibility: visible;
          transition: opacity 500ms ease-in;
      }

      form div.field p.help.is-danger {
        padding-left: 0.6rem;
        padding-top: 0.4rem;
        padding-bottom: 0.3rem;
        font-size: 100%;
      }

      div#messageFieldError>p.help.is-danger {
        padding-top: 0.4rem;
        padding-bottom: 0.3rem;
        font-size: 100%;
      }
    </style>
    <main class="container" style="max-width: 30em; margin-top: 6rem;">
      <section class="article">
        <h1 class="title">Contact</h1>
        
  
  <script>
    const inlineValidate = (validatorName, event) => {
      event.detail.ctx.sourceElement.classList.remove('is-danger')
      const name = event.detail.ctx.sourceElement.name
      const formData = event.detail.ctx.request.body

      for (const [key, value] of [...formData.entries()]) {
        if (key !== name) {
          formData.delete(key)
        } else {
          formData.delete(key)
          formData.set("name", validatorName)
          formData.set("value", value)
        }
      }
    }
  </script>
  <form
    method="post"
    enctype="multipart/form-data"
    hx-target="this"
    hx-swap="outerHTML"
    hx-post=""
    hx-disable="button, input, textarea, select, this"
    class="form m-4">
    <fieldset>
      <div class="field">
        <label for="name" class="label">
          Name &nbsp;*
        </label>
        <div class="control">
          <input
            type="name"
            name="name"
            class="input is-danger"
            value=""
            hx-patch=""
            hx-trigger="input changed delay:300ms"
            hx-target="global #nameFieldError"
            hx-swap="innerHTML"
            hx-indicator="closest form"
            hx-sync="closest form:abort"
            hx-on:htmx:response:error="this.classList.add('is-danger')"
            hx-on:htmx:config:request="inlineValidate('name', event)"
            required
          />
        </div>
        <div id="nameFieldError"><p class="help is-danger">⚠️&nbsp;&nbsp;Name is required.</p></div>
      </div>
      <div class="field">
        <label for="email" class="label">
          Email &nbsp;*
        </label>
        <div class="control">
          <input
            type="email"
            name="email"
            class="input is-danger"
            value=""
            hx-patch=""
            hx-trigger="input changed delay:300ms"
            hx-target="global #emailFieldError"
            hx-swap="innerHTML"
            hx-indicator="closest form"
            hx-sync="closest form:abort"
            hx-on:htmx:response:error="this.classList.add('is-danger')"
            hx-on:htmx:config:request="inlineValidate('email', event)"
            required
          />
        </div>
        <div id="emailFieldError"><p class="help is-danger">⚠️&nbsp;&nbsp;Email is required.</p></div>
      </div>
      <div class="field">
        <label for="phone" class="label">
          Phone
        </label>
        <div class="control">
          <input
            type="phone"
            name="phone"
            class="input"
            value=""
            hx-patch=""
            hx-trigger="input changed delay:300ms"
            hx-target="global #phoneFieldError"
            hx-swap="innerHTML"
            hx-indicator="closest form"
            hx-sync="closest form:abort"
            hx-on:htmx:response:error="this.classList.add('is-danger')"
            hx-on:htmx:config:request="inlineValidate('phone', event)"
          />
        </div>
        <div id="phoneFieldError"></div>
      </div>
      <div class="field">
        <label for="message" class="label">
          Message &nbsp;*
        </label>
        <div class="control">
          <textarea
            name="message"
            class="textarea is-danger"
            hx-patch=""
            hx-trigger="input changed delay:300ms"
            hx-target="global #messageFieldError"
            hx-swap="innerHTML"
            hx-indicator="closest form"
            hx-sync="closest form:abort"
            hx-on:htmx:response:error="this.classList.add('is-danger')"
            hx-on:htmx:config:request="inlineValidate('message', event)"
            required
          ></textarea>
        </div>
        <div id="messageFieldError"><p class="help is-danger">⚠️&nbsp;&nbsp;Message is required.</p></div>
      </div>
      <p>
        <button type="submit" class="button is-primary">Send</button>
        <svg id="spinner" class="htmx-indicator"
          fill="hsl(228, 97%, 42%)" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="RadialGradient8932"><stop offset="0%" stop-color="currentColor" stop-opacity="1"/><stop offset="100%" stop-color="currentColor" stop-opacity="0.25"/></linearGradient></defs>
            <style>
              @keyframes spin8932 {
                  to {
                      transform: rotate(360deg);
                  }
              }

              #circle8932 {
                  transform-origin: 50% 50%;
                  stroke: url(#RadialGradient8932);
                  fill: none;
                  animation: spin8932 .5s infinite linear;
              }
            </style>
          <circle cx="10" cy="10" r="8" id="circle8932" stroke-width="2"/>
        </svg>
      </p>
    </fieldset>
  </form>
  

      </section>
    </main>
  </body>
</html>
