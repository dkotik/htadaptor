<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <title>Contact</title>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
      integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
      crossorigin="anonymous"></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    >
  </head>
  <body>
    <style>
      .htmx-indicator {
          opacity: 0;
          visibility: hidden;
          max-height: 1.5rem;
          max-width: 1.5rem;
          margin: 0.4rem 1rem 0 1rem;
      }
      .htmx-request .htmx-indicator,
      .htmx-request.htmx-indicator {
          opacity: 1;
          visibility: visible;
          transition: opacity 200ms ease-in;
      }
    </style>
    <main class="container">
      <h1 class="title">Contact</h1>
      
  
  <form method="post" enctype="multipart/form-data" hx-target="this" hx-swap="innerHTML" hx-post="" class="form m-4">
    <fieldset><div class="field">
  <label for="name" class="label">
    Name &nbsp;*
  </label>
  <div class="control" hx-target="next .error">
    <input
      type="text"
      name="name"
      class="input is-danger"
      value=""
      hx-patch=""
      hx-params="name"
      hx-trigger="blur, change, keyup delay:300ms changed"
      hx-swap="innerHTML"
      hx-indicator="closest form"
    />
  </div>
  
  <div class="error">
    
      <p class="help is-danger">Name is required</p>
    
  </div>
</div><div class="field">
  <label for="email" class="label">
    Email &nbsp;*
  </label>
  <div class="control" hx-target="next .error">
    <input
      type="email"
      name="email"
      class="input is-danger"
      value=""
      hx-patch=""
      hx-params="email"
      hx-trigger="blur, change, keyup delay:300ms changed"
      hx-swap="innerHTML"
      hx-indicator="closest form"
    />
  </div>
  
  <div class="error">
    
      <p class="help is-danger">Email is required</p>
    
  </div>
</div><div class="field">
  <label for="phone" class="label">
    Phone
  </label>
  <div class="control" hx-target="next .error">
    <input
      type="text"
      name="phone"
      class="input"
      value=""
      hx-patch=""
      hx-params="phone"
      hx-trigger="blur, change, keyup delay:300ms changed"
      hx-swap="innerHTML"
      hx-indicator="closest form"
    />
  </div>
  
  <div class="error">
    
  </div>
</div><div class="field">
  <label for="message" class="label">
    Message &nbsp;*
  </label>
  <div class="control" hx-target="next .error">
    <textarea
      name="message"
      class="textarea is-danger"
      hx-patch=""
      hx-params="message"
      hx-trigger="blur, change, keyup delay:300ms changed"
      hx-swap="outerHTML"
      hx-indicator="closest form"
    ></textarea>
  </div>
  
  <div class="error">
    
      <p class="help is-danger">Message is required.</p>
    
  </div>
</div><p>
        <button type="submit" class="button is-primary">Send</button>
        <img id="spinner" class="htmx-indicator" src="/spinner.svg" alt="Loading..."/>
      </p>
    </fieldset>
  </form>
  

    </main>
  </body>
</html>
